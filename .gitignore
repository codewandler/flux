/target
**/*.rs.bk
# `.flux/` is local scaffolding (session state, seeded self-improvement roles, …) and stays
# gitignored — EXCEPT the strict-review example's reviewer roles (L-10), which are a checked-in
# part of examples/strict_review.flux, not local scaffolding, so ship them with the repo. A
# directory-level `.flux/` pattern would block re-inclusion entirely, so exclude by content instead.
.flux/*
!.flux/agents/
.flux/agents/*
!.flux/agents/review-*.md
*.db
*.db-wal
*.db-shm
.env

# Node / Docusaurus
node_modules/
website/.docusaurus/
website/build/

# IDE
/.idea/

# Python (terminal-bench agent shim)
__pycache__/
*.pyc

# I-03 measurement raw recordings (local evidence, re-derivable reports)
bench/ttff/results/
bench/tbench-compare/results/
